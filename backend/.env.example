# Application Configuration
APP_NAME=FasalDisha-Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Defaults to local SQLite fallback if PostgreSQL is not provided)
DATABASE_URL=sqlite:///./fasal_disha.db
# Primary PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fasaldisha

# SSOT Scenario Flags & Thresholds
SEEDED_RISK_OVERRIDE_SCENARIO_ENABLED=true
PEAK_ALERT_THRESHOLD=0.05
RADIUS_KM_DEFAULT=100
RADIUS_KM_MAX=300
TRANSPORT_RATE_PER_QUINTAL_PER_KM=2.5
